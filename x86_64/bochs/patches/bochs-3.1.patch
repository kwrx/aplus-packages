+/**
+ * @brief Redraws a status bar field after its state changed.
+ * @param element The field.
+ * @param active Whether it is lit.
+ * @param w Whether it shows a write, red if it turns itself off, yellow otherwise.
+ */
+void bx_aplus_gui_c::statusbar_setitem_specific(int element, bool active, bool w)
+{
+  Bit8u color = 0;
+  if (w) {
+    color = (statusitem[element].auto_off) ? 1 : 2;
+  }
+  aplus_set_status_text(element + 1, statusitem[element].text, active, color);
+}
+
+/**
+ * @brief Reports the largest mode the guest may set, since aplus-wm does not tell the display size.
+ */
+void bx_aplus_gui_c::get_capabilities(Bit16u *xres, Bit16u *yres, Bit16u *bpp)
+{
+  *xres = APLUS_MAX_XRES;
+  *yres = APLUS_MAX_YRES;
+  *bpp = 32;
+}
+
+/**
+ * @brief Switches the guest mouse between relative and absolute reports.
+ * @param mode Whether a tablet-like device wants absolute coordinates.
+ */
+void bx_aplus_gui_c::set_mouse_mode_absxy(bool mode)
+{
+  mouse_absxy = mode;
+}
+
+#if BX_SHOW_IPS
+/**
+ * @brief Formats the instructions per second for the status bar's message field.
+ * @param ips_count Instructions run in the last second.
+ */
+void bx_aplus_gui_c::show_ips(Bit32u ips_count)
+{
+  if (!gui_opts.hide_ips && !ips_update) {
+    ips_count /= 1000;
+    sprintf(ips_text, "IPS: %u.%3.3uM", ips_count / 1000, ips_count % 1000);
+    ips_update = 1;
+  }
+}
+#endif
+
+#endif /* if BX_WITH_APLUS */
