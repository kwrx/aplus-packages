+/**
+ * @brief Hands the guest a tile of the frame buffer to draw into directly.
+ * @param x0 Left edge in guest coordinates.
+ * @param y0 Top edge in guest coordinates.
+ * @param w Receives the tile width, clipped to the guest area.
+ * @param h Receives the tile height, clipped to the guest area.
+ * @return The tile's first pixel.
+ */
+Bit8u *bx_aplus_gui_c::graphics_tile_get(unsigned x0, unsigned y0, unsigned *w, unsigned *h)
+{
+  *w = (x0 + x_tilesize > res_x) ? res_x - x0 : x_tilesize;
+  *h = (y0 + y_tilesize > res_y) ? res_y - y0 : y_tilesize;
+  return (Bit8u *)(fb + (size_t)(headerbar_height + y0) * fb_width + x0);
+}
