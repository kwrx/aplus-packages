+                                 bx_vga_tminfo_t *tm_info)
+{
+}
+
+/**
+ * @brief Draws an 8 bpp tile through the palette.
+ * @param tile The tile's palette indices.
+ * @param x Left edge in guest coordinates.
+ * @param y Top edge in guest coordinates.
+ */
+void bx_aplus_gui_c::graphics_tile_update(Bit8u *tile, unsigned x, unsigned y)
+{
+  if ((x >= res_x) || (y >= res_y)) return;
+
+  unsigned h = y_tilesize;
+  unsigned w = x_tilesize;
+  if (y + h > res_y) h = res_y - y;
+  if (x + w > res_x) w = res_x - x;
+
+  Bit32u *buf = fb + (size_t)(headerbar_height + y) * fb_width + x;
+  for (unsigned j = 0; j < h; j++) {
+    for (unsigned i = 0; i < w; i++) {
+      buf[i] = aplus_palette[tile[i]];
+    }
+    tile += x_tilesize;
+    buf += fb_width;
+  }
+  aplus_damage(x, headerbar_height + y, w, h);
+}
+
+/**
+ * @brief Drains the window's events, refreshes the IPS field once a second and presents what changed.
+ */
+void bx_aplus_gui_c::handle_events(void)
+{
+  ui_event_t ev;
+  int e;
+
+  while ((e = ui_next_event(conn, &ev, 0)) > 0) {
+    switch (ev.type) {
+      case UI_EVENT_CONFIGURE:
+        if (ui_window_apply_configure(win) < 0) {
+          BX_PANIC(("ui_window_apply_configure() failed: %s", strerror(errno)));
+        }
+        aplus_damage(0, 0, fb_width, fb_height);
+        break;
+      case UI_EVENT_FOCUS:
+        if (!ev.focus.focused) aplus_release_keys();
+        break;
+      case UI_EVENT_KEY:
+        handle_key(ev.key.vkey, ev.key.down);
+        break;
+      case UI_EVENT_POINTER:
+        handle_pointer(ev.pointer.x, ev.pointer.y, ev.pointer.buttons);
+        break;
+      case UI_EVENT_SCROLL:
+        handle_scroll(ev.scroll.dy);
+        break;
+      case UI_EVENT_CLOSE:
+        BX_FATAL(("User requested shutdown."));
+        break;
+      default:
+        break;
+    }
+  }
+  if (e < 0) {
+    BX_FATAL(("Lost the connection to aplus-wm: %s", strerror(errno)));
+  }
+
+#if BX_SHOW_IPS
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  if (now.tv_sec > ips_last.tv_sec) {
+    ips_last = now;
+    bx_show_ips_handler();
+  }
+  if (ips_update && !show_info_msg) {
+    ips_update = 0;
+    aplus_set_status_text(0, ips_text, 1);
+  }
+#endif
+
+  aplus_present();
+}
