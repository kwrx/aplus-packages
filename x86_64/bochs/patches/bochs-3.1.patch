+/**
+ * @brief Follows a guest mode change: resizes the frame buffer and asks aplus-wm for the matching window size.
+ * @param x Guest width.
+ * @param y Guest height.
+ * @param fheight Text mode font height, 0 in graphics modes.
+ * @param fwidth Text mode font width.
+ * @param bpp Guest colour depth.
+ */
+void bx_aplus_gui_c::dimension_update(unsigned x, unsigned y,
+                                      unsigned fheight, unsigned fwidth, unsigned bpp)
+{
+  if (bpp == 8 || bpp == 15 || bpp == 16 || bpp == 24 || bpp == 32) {
+    guest_bpp = bpp;
+  } else {
+    BX_PANIC(("%d bpp graphics mode not supported", bpp));
+  }
+  guest_textmode = (fheight > 0);
+  guest_fwidth = fwidth;
+  guest_fheight = fheight;
+  guest_xres = x;
+  guest_yres = y;
+
+  if ((x == res_x) && (y == res_y)) return;
+
+  if ((x > APLUS_MAX_XRES) || (y > APLUS_MAX_YRES)) {
+    BX_PANIC(("dimension_update(): resolution of out of display bounds"));
+    return;
+  }
+
+  delete [] fb;
+  res_x = x;
+  res_y = y;
+  fb_width = x;
+  fb_height = y + headerbar_height + statusbar_height;
+  fb = new Bit32u[(size_t)fb_width * fb_height];
+  memset(fb, 0, (size_t)fb_width * fb_height * 4);
+
+  if (ui_window_request_size(win, fb_width, fb_height) < 0) {
+    BX_ERROR(("ui_window_request_size() failed: %s", strerror(errno)));
+  }
+
+  show_headerbar();
+  host_xres = x;
+  host_yres = y;
+  host_bpp = 32;
+}
+
+/**
+ * @brief Expands a 1 bpp bitmap into headerbar colours.
+ * @param bmap The bitmap, LSB first.
+ * @param xdim Width, a multiple of 8.
+ * @param ydim Height.
+ * @return The bitmap's id.
+ */
+unsigned bx_aplus_gui_c::create_bitmap(const unsigned char *bmap, unsigned xdim, unsigned ydim)
+{
+  if (n_bitmaps >= APLUS_MAX_BITMAPS) {
+    BX_PANIC(("too many aplus bitmaps. To fix, increase APLUS_MAX_BITMAPS"));
+    return 0;
+  }
+
+  aplus_bitmap *bmp = new aplus_bitmap;
+  bmp->width = xdim;
+  bmp->height = ydim;
+  bmp->xorigin = -1;
+  bmp->pixels = new Bit32u[xdim * ydim];
+
+  Bit32u *buf = bmp->pixels;
+  for (unsigned j = 0; j < ydim; j++) {
+    for (unsigned i = 0; i < xdim / 8; i++) {
+      unsigned char pixels = *bmap++;
+      for (unsigned k = 0; k < 8; k++) {
+        *buf++ = (pixels & 0x01) ? headerbar_fg : headerbar_bg;
+        pixels >>= 1;
+      }
+    }
+  }
+
+  bitmaps[n_bitmaps] = bmp;
+  return n_bitmaps++;
+}
+
+/**
+ * @brief Places a bitmap on the headerbar, packed from the left or the right.
+ * @param bmap_id The bitmap.
+ * @param alignment BX_GRAVITY_LEFT or BX_GRAVITY_RIGHT.
+ * @param f The handler a click runs.
+ * @return The headerbar entry.
+ */
+unsigned bx_aplus_gui_c::headerbar_bitmap(unsigned bmap_id, unsigned alignment, void (*f)(void))
+{
+  if (bmap_id >= n_bitmaps) return 0;
+
+  if ((bx_headerbar_entries + 1) > BX_MAX_HEADERBAR_ENTRIES)
+    BX_PANIC(("too many headerbar entries, increase BX_MAX_HEADERBAR_ENTRIES"));
+
+  unsigned hb_index = bx_headerbar_entries++;
+  aplus_bitmap *bmp = bitmaps[bmap_id];
+
+  bx_headerbar_entry[hb_index].bmap_id = bmap_id;
+  bx_headerbar_entry[hb_index].xdim = bmp->width;
+  bx_headerbar_entry[hb_index].ydim = bmp->height;
+  bx_headerbar_entry[hb_index].alignment = alignment;
+  bx_headerbar_entry[hb_index].f = f;
+
+  if (alignment == BX_GRAVITY_LEFT) {
+    bmp->xorigin = bitmap_left_xorigin;
+    bitmap_left_xorigin += bmp->width;
+  } else {
+    bitmap_right_xorigin += bmp->width;
+    bmp->xorigin = bitmap_right_xorigin;
+  }
+  bx_headerbar_entry[hb_index].xorigin = bmp->xorigin;
+
+  return hb_index;
+}
+
+/**
+ * @brief Swaps the bitmap of a headerbar entry, as a floppy or mouse button changes state.
+ * @param hbar_id The headerbar entry.
+ * @param bmap_id The new bitmap.
+ */
+void bx_aplus_gui_c::replace_bitmap(unsigned hbar_id, unsigned bmap_id)
+{
+  unsigned old_id = bx_headerbar_entry[hbar_id].bmap_id;
+  int xorigin = bitmaps[old_id]->xorigin;
+
+  bitmaps[old_id]->xorigin = -1;
+  bx_headerbar_entry[hbar_id].bmap_id = bmap_id;
+  bitmaps[bmap_id]->xorigin = xorigin;
+
+  if (!fb || (xorigin == -1)) return;
+  if (bx_headerbar_entry[hbar_id].alignment == BX_GRAVITY_RIGHT) {
+    xorigin = res_x - xorigin;
+  }
+  aplus_blit(bitmaps[bmap_id], xorigin);
+}
+
+/**
+ * @brief Redraws the headerbar and the status bar from scratch.
+ */
+void bx_aplus_gui_c::show_headerbar(void)
+{
+  if (!fb) return;
+
+  aplus_fill(0, 0, res_x, headerbar_height, headerbar_bg);
+  for (unsigned i = bx_headerbar_entries; i-- > 0;) {
+    aplus_bitmap *bmp = bitmaps[bx_headerbar_entry[i].bmap_id];
+    if (bmp->xorigin == -1) continue;
+    int x = bmp->xorigin;
+    if (bx_headerbar_entry[i].alignment == BX_GRAVITY_RIGHT) {
+      x = res_x - x;
+    }
+    aplus_blit(bmp, x);
+  }
+
+  int ytop = res_y + headerbar_height;
+  aplus_fill(0, ytop, res_x, statusbar_height, headerbar_bg);
+  for (unsigned i = 1; i < 12; i++) {
+    if (statusitem_pos[i] >= res_x) break;
+    aplus_fill(statusitem_pos[i], ytop, 1, statusbar_height, headerbar_fg);
+  }
+  for (unsigned i = 0; i < statusitem_count; i++) {
+    aplus_set_status_text(i + 1, statusitem[i].text, statusitem_active[i + 1]);
+  }
+}
