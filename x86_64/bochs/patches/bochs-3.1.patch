+/**
+ * @brief Packs an RGB triple into the window's XRGB32 pixel format.
+ * @param r Red.
+ * @param g Green.
+ * @param b Blue.
+ * @return The pixel.
+ */
+static inline Bit32u aplus_rgb(Bit8u r, Bit8u g, Bit8u b)
+{
+  return ((Bit32u)r << 16) | ((Bit32u)g << 8) | (Bit32u)b;
+}
+
+/**
+ * @brief Grows the dirty box to cover a rectangle of the frame buffer.
+ * @param x Left edge.
+ * @param y Top edge.
+ * @param w Width.
+ * @param h Height.
+ */
+static void aplus_damage(int x, int y, int w, int h)
+{
+  if ((w <= 0) || (h <= 0)) return;
+  if (!dirty) {
+    dirty_x0 = x;
+    dirty_y0 = y;
+    dirty_x1 = x + w;
+    dirty_y1 = y + h;
+    dirty = 1;
+    return;
+  }
+  if (x < dirty_x0) dirty_x0 = x;
+  if (y < dirty_y0) dirty_y0 = y;
+  if (x + w > dirty_x1) dirty_x1 = x + w;
+  if (y + h > dirty_y1) dirty_y1 = y + h;
+}
+
+/**
+ * @brief Copies the dirty box into the window's back buffer and commits it.
+ */
+static void aplus_present(void)
+{
+  if (!dirty || !win || !fb) return;
+  dirty = 0;
+
+  int x0 = dirty_x0 < 0 ? 0 : dirty_x0;
+  int y0 = dirty_y0 < 0 ? 0 : dirty_y0;
+  int x1 = dirty_x1;
+  int y1 = dirty_y1;
+  if (x1 > (int)fb_width) x1 = fb_width;
+  if (y1 > (int)fb_height) y1 = fb_height;
+  if (x1 > ui_window_width(win)) x1 = ui_window_width(win);
+  if (y1 > ui_window_height(win)) y1 = ui_window_height(win);
+  if ((x0 >= x1) || (y0 >= y1)) return;
+
+  Bit8u *dst = (Bit8u *)ui_window_pixels(win);
+  size_t stride = ui_window_stride(win);
+  for (int y = y0; y < y1; y++) {
+    memcpy(dst + (size_t)y * stride + (size_t)x0 * 4, fb + (size_t)y * fb_width + x0, (size_t)(x1 - x0) * 4);
+  }
+  ui_window_damage(win, x0, y0, x1 - x0, y1 - y0);
+  if (ui_window_commit(win) < 0) {
+    BX_ERROR(("ui_window_commit() failed: %s", strerror(errno)));
+  }
+}
+
+/**
+ * @brief Fills a rectangle of the frame buffer with one colour.
+ * @param x Left edge.
+ * @param y Top edge.
+ * @param w Width.
+ * @param h Height.
+ * @param color The pixel to fill with.
+ */
+static void aplus_fill(int x, int y, int w, int h, Bit32u color)
+{
+  for (int j = y; j < y + h; j++) {
+    Bit32u *row = fb + (size_t)j * fb_width + x;
+    for (int i = 0; i < w; i++) {
+      row[i] = color;
+    }
+  }
+  aplus_damage(x, y, w, h);
+}
+
+/**
+ * @brief Copies a headerbar bitmap into the frame buffer.
+ * @param bmp The bitmap.
+ * @param x Left edge in the frame buffer.
+ */
+static void aplus_blit(const aplus_bitmap *bmp, int x)
+{
+  unsigned w = bmp->width;
+  if (x < 0) return;
+  if ((unsigned)x + w > fb_width) w = fb_width - x;
+  for (unsigned j = 0; j < bmp->height; j++) {
+    memcpy(fb + (size_t)j * fb_width + x, bmp->pixels + (size_t)j * bmp->width, w * 4);
+  }
+  aplus_damage(x, 0, w, bmp->height);
+}
+
+/**
+ * @brief Draws one status bar field with its text, lit or greyed.
+ * @param element The field, 0 being the message area.
+ * @param text The text to show.
+ * @param active Whether the field is lit.
+ * @param color The LED colour for a lit field: green, red or yellow.
+ */
+static void aplus_set_status_text(int element, const char *text, bool active, Bit8u color = 0)
+{
+  statusitem_active[element] = active;
+  if (!fb) return;
+
+  int xleft = statusitem_pos[element] + 2;
+  int xsize = statusitem_pos[element + 1] - xleft - 1;
+  int ytop = res_y + headerbar_height + 1;
+  if (xleft + xsize > (int)fb_width) xsize = fb_width - xleft;
+  if (xsize <= 0) return;
+
+  Bit32u fgcolor = active ? headerbar_fg : status_gray_text;
+  Bit32u bgcolor = ((element > 0) && active) ? status_leds[color] : headerbar_bg;
+  aplus_fill(xleft, ytop, xsize, statusbar_height - 2, bgcolor);
+
+  int textlen = strlen(text);
+  if ((element > 0) && (textlen > 6)) textlen = 6;
+  if (textlen * 8 > xsize) textlen = xsize / 8;
+  for (int c = 0; c < textlen; c++) {
+    const unsigned char *glyph = menufont[(unsigned char)text[c]];
+    for (int row = 0; row < 8; row++) {
+      Bit32u *buf = fb + (size_t)(ytop + 4 + row) * fb_width + xleft + c * 8;
+      unsigned char bits = glyph[row];
+      for (int col = 0; col < 8; col++) {
+        if (bits & 0x80) buf[col] = fgcolor;
+        bits <<= 1;
+      }
+    }
+  }
+}
