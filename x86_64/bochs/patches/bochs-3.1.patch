+/**
+ * @brief Runs a command mode key: the floppy, copy, paste, log, reset, snapshot, user, config, power and save buttons.
+ * @param vkey The key pressed while command mode was active.
+ */
+void bx_aplus_gui_c::command_key(Bit16u vkey)
+{
+  if (get_modifier_keys() == 0) {
+    switch (vkey) {
+      case KEY_A: floppyA_handler(); break;
+      case KEY_B: floppyB_handler(); break;
+      case KEY_C: copy_handler(); break;
+      case KEY_M: marklog_handler(); break;
+      case KEY_P: paste_handler(); break;
+      case KEY_R: reset_handler(); break;
+      case KEY_S: snapshot_handler(); break;
+      case KEY_U: userbutton_handler(); break;
+    }
+  } else if (get_modifier_keys() == BX_MOD_KEY_SHIFT) {
+    switch (vkey) {
+      case KEY_C: config_handler(); break;
+      case KEY_P: power_handler(); break;
+      case KEY_S: save_restore_handler(); break;
+    }
+  }
+}
+
+/**
+ * @brief Handles a key going down or up: modifiers, mouse toggle, command mode, then the guest keyboard.
+ * @param vkey The KEY_* code.
+ * @param down Whether the key went down.
+ */
+void bx_aplus_gui_c::handle_key(Bit16u vkey, bool down)
+{
+  Bit8u kmodchange = 0;
+  bool repeat = 0;
+
+  if (vkey < KEY_CNT) {
+    repeat = down && keys_down[vkey];
+    keys_down[vkey] = down;
+  }
+
+  if ((vkey == KEY_LEFTSHIFT) || (vkey == KEY_RIGHTSHIFT)) {
+    kmodchange = set_modifier_keys(BX_MOD_KEY_SHIFT, down);
+  } else if ((vkey == KEY_LEFTCTRL) || (vkey == KEY_RIGHTCTRL)) {
+    kmodchange = set_modifier_keys(BX_MOD_KEY_CTRL, down);
+  } else if (vkey == KEY_LEFTALT) {
+    kmodchange = set_modifier_keys(BX_MOD_KEY_ALT, down);
+  } else if ((vkey == KEY_CAPSLOCK) && down) {
+    kmodchange = set_modifier_keys(BX_MOD_KEY_CAPS, 1);
+  }
+
+  bool mouse_toggle = 0;
+  if ((kmodchange & BX_MOD_KEY_CTRL) > 0) {
+    mouse_toggle = mouse_toggle_check(BX_MT_KEY_CTRL, down);
+  } else if ((kmodchange & BX_MOD_KEY_ALT) > 0) {
+    mouse_toggle = mouse_toggle_check(BX_MT_KEY_ALT, down);
+  } else if (vkey == KEY_F10) {
+    mouse_toggle = mouse_toggle_check(BX_MT_KEY_F10, down);
+  } else if (vkey == KEY_F12) {
+    mouse_toggle = mouse_toggle_check(BX_MT_KEY_F12, down);
+  } else if (vkey == KEY_G) {
+    mouse_toggle = mouse_toggle_check(BX_MT_KEY_G, down);
+  }
+  if (down && mouse_toggle) {
+    toggle_mouse_enable();
+    return;
+  }
+
+  if (down) {
+    if (command_mode_active()) {
+      command_key(vkey);
+      if (kmodchange == 0) {
+        set_command_mode(0);
+#if BX_SHOW_IPS
+        show_info_msg = 0;
+#endif
+      }
+      if (vkey != APLUS_COMMAND_VKEY) return;
+    } else if (has_command_mode() && (get_modifier_keys() == 0) && (vkey == APLUS_COMMAND_VKEY)) {
+      set_command_mode(1);
+      aplus_set_status_text(0, "Command mode", 1);
+#if BX_SHOW_IPS
+      show_info_msg = 1;
+#endif
+      return;
+    }
+    if (repeat && gui_opts.nokeyrepeat) return;
+  }
+
+  Bit32u key_event = aplus_vkey_to_bx_key(vkey);
+  if (key_event == BX_KEY_UNHANDLED) return;
+  DEV_kbd_gen_scancode(down ? key_event : (key_event | BX_KEY_RELEASED));
+}
+
+/**
+ * @brief Handles a pointer event: the middle-button toggle, headerbar clicks, then the guest mouse.
+ * @param x Pointer position in the content area.
+ * @param y Pointer position in the content area.
+ * @param buttons UI_BUTTON_* held, which match Bochs's left/right/middle bits.
+ */
+void bx_aplus_gui_c::handle_pointer(int x, int y, Bit8u buttons)
+{
+  Bit8u pressed = buttons & ~old_mousebuttons;
+  Bit8u released = old_mousebuttons & ~buttons;
+  int dx = x - old_mousex;
+  int dy = y - old_mousey;
+
+  old_mousex = x;
+  old_mousey = y;
+  old_mousebuttons = buttons;
+
+  if (pressed & UI_BUTTON_MIDDLE) {
+    if (mouse_toggle_check(BX_MT_MBUTTON, 1)) {
+      toggle_mouse_enable();
+    }
+    return;
+  }
+  if (released & UI_BUTTON_MIDDLE) {
+    mouse_toggle_check(BX_MT_MBUTTON, 0);
+  }
+  if ((pressed & UI_BUTTON_LEFT) && (y < headerbar_height)) {
+    headerbar_click(x);
+    return;
+  }
+  if (!mouse_grab) return;
+
+  if (mouse_absxy) {
+    if ((y >= headerbar_height) && (y < (int)res_y + headerbar_height)) {
+      DEV_mouse_motion(x * 0x7fff / res_x, (y - headerbar_height) * 0x7fff / res_y, 0, buttons, 1);
+    }
+  } else {
+    DEV_mouse_motion(dx, -dy, 0, buttons, 0);
+  }
+}
+
+/**
+ * @brief Handles a wheel step for the guest mouse.
+ * @param dz The step, positive away from the user.
+ */
+void bx_aplus_gui_c::handle_scroll(int dz)
+{
+  if (!mouse_grab) return;
+  if (mouse_absxy) {
+    DEV_mouse_motion(old_mousex * 0x7fff / res_x, (old_mousey - headerbar_height) * 0x7fff / res_y, dz, old_mousebuttons, 1);
+  } else {
+    DEV_mouse_motion(0, 0, dz, old_mousebuttons, 0);
+  }
+}
+
+/**
+ * @brief Forgets every held key once the window loses focus, so none stays down in the guest.
+ */
+static void aplus_release_keys(void)
+{
+  memset(keys_down, 0, sizeof(keys_down));
+  DEV_kbd_release_keys();
+}
