+    case KEY_DOT:          return BX_KEY_PERIOD;
+    case KEY_SLASH:        return BX_KEY_SLASH;
+    case KEY_RIGHTSHIFT:   return BX_KEY_SHIFT_R;
+    case KEY_KPASTERISK:   return BX_KEY_KP_MULTIPLY;
+    case KEY_LEFTALT:      return BX_KEY_ALT_L;
+    case KEY_SPACE:        return BX_KEY_SPACE;
+    case KEY_CAPSLOCK:     return BX_KEY_CAPS_LOCK;
+    case KEY_F1:           return BX_KEY_F1;
+    case KEY_F2:           return BX_KEY_F2;
+    case KEY_F3:           return BX_KEY_F3;
+    case KEY_F4:           return BX_KEY_F4;
