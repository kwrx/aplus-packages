+/**
+ * @brief Opens the window at 640x480 and parses the aplus display options.
+ * @param argc Number of display options.
+ * @param argv The display options.
+ * @param headerbar_y Height of the headerbar.
+ */
+void bx_aplus_gui_c::specific_init(int argc, char **argv, unsigned headerbar_y)
+{
+  put("APLUS");
+
+  headerbar_height = headerbar_y;
+
+  for (int i = 0; i < 256; i++) {
+    for (int j = 0; j < 16; j++) {
+      vga_charmap[0][i * 32 + j] = sdl_font8x16[i][j];
+      vga_charmap[1][i * 32 + j] = sdl_font8x16[i][j];
+    }
+    for (int j = 0; j < 8; j++) {
+      menufont[i][j] = sdl_font8x8[i][j];
+    }
+  }
+
+  win = ui_window_create(conn, 640, 480 + headerbar_height + statusbar_height, "Bochs");
+  if (!win) {
+    BX_FATAL(("Unable to create the aplus window: %s", strerror(errno)));
+    return;
+  }
+
+  dimension_update(640, 480);
+
+  if (SIM->get_param_bool(BXPN_KBD_USEMAPPING)->get()) {
+    BX_INFO(("keyboard mapping is not supported by the aplus gui, ignoring it"));
+  }
+
+  Bit8u flags = BX_GUI_OPT_NOKEYREPEAT | BX_GUI_OPT_HIDE_IPS | BX_GUI_OPT_CMDMODE;
+  for (int i = 1; i < argc; i++) {
+    if (!parse_common_gui_options(argv[i], flags)) {
+      BX_PANIC(("Unknown aplus option '%s'", argv[i]));
+    }
+  }
+
+#if BX_SHOW_IPS
+  clock_gettime(CLOCK_MONOTONIC, &ips_last);
+#endif
+
+  new_gfx_api = 1;
+  new_text_api = 1;
+}
+
+/**
+ * @brief Draws one text mode character cell, cursor included, from the VGA font.
+ */
+void bx_aplus_gui_c::draw_char(Bit8u ch, Bit8u fc, Bit8u bc, Bit16u xc, Bit16u yc,
+                               Bit8u fw, Bit8u fh, Bit8u fx, Bit8u fy,
+                               bool gfxcharw9, Bit8u cs, Bit8u ce, bool curs, bool font2)
+{
+  Bit32u *buf = fb + (size_t)(headerbar_height + yc) * fb_width + xc;
+  Bit32u fgcolor = aplus_palette[fc];
+  Bit32u bgcolor = aplus_palette[bc];
+  bool dwidth = (guest_fwidth > 9);
+  Bit8u *font_ptr = &vga_charmap[font2 ? 1 : 0][(ch << 5) + fy];
+  Bit8u rows = fh;
+
+  do {
+    Bit16u font_row = *font_ptr++;
+    if (gfxcharw9) {
+      font_row = (font_row << 1) | (font_row & 0x01);
+    } else {
+      font_row <<= 1;
+    }
+    if (fx > 0) {
+      font_row <<= fx;
+    }
+    Bit16u mask = (curs && (fy >= cs) && (fy <= ce)) ? 0x100 : 0x00;
+    Bit8u fontpixels = fw;
+    do {
+      *buf++ = ((font_row & 0x100) == mask) ? bgcolor : fgcolor;
+      if (!dwidth || (fontpixels & 1)) font_row <<= 1;
+    } while (--fontpixels);
+    buf += (fb_width - fw);
+    fy++;
+  } while (--rows);
+
+  aplus_damage(xc, headerbar_height + yc, fw, fh);
+}
