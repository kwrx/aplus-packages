+/**
+ * @brief Describes the frame buffer as 32 bpp XRGB for the new graphics API.
+ * @param info Receives the layout.
+ * @return info.
+ */
+bx_svga_tileinfo_t *bx_aplus_gui_c::graphics_tile_info(bx_svga_tileinfo_t *info)
+{
+  info->bpp = 32;
+  info->pitch = fb_width * 4;
+  info->red_shift = 24;
+  info->green_shift = 16;
+  info->blue_shift = 8;
+  info->red_mask = 0x00ff0000;
+  info->green_mask = 0x0000ff00;
+  info->blue_mask = 0x000000ff;
+  info->is_indexed = 0;
+  info->is_little_endian = 1;
