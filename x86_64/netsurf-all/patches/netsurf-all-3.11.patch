+
+/** the buttons the server reports, in the order libnsfb numbers its mouse keys */
+static const struct {
+    uint8_t mask;
+    enum nsfb_key_code_e keycode;
+} aplus_button_map[] = {
+    { UI_BUTTON_LEFT, NSFB_KEY_MOUSE_1 },
+    { UI_BUTTON_MIDDLE, NSFB_KEY_MOUSE_2 },
+    { UI_BUTTON_RIGHT, NSFB_KEY_MOUSE_3 },
+};
+
+/**
+ * @brief Adds an event to the queue, dropping it when there is no room left.
+ *
+ * @param state The surface state holding the queue.
+ * @param event The event to add.
+ */
+static void aplus_queue_push(aplus_state_t *state, const nsfb_event_t *event)
+{
+    unsigned next = (state->tail + 1) % APLUS_EVENT_QUEUE;
+
+    if (next == state->head) {
+        return;
+    }
+
+    state->queue[state->tail] = *event;
+    state->tail = next;
+}
+
+/**
+ * @brief Takes the oldest event off the queue.
+ *
+ * @param state The surface state holding the queue.
+ * @param event Receives the event.
+ * @return true when an event was taken, false when the queue was empty.
+ */
+static bool aplus_queue_pop(aplus_state_t *state, nsfb_event_t *event)
+{
+    if (state->head == state->tail) {
+        return false;
+    }
+
+    *event = state->queue[state->head];
+    state->head = (state->head + 1) % APLUS_EVENT_QUEUE;
+
+    return true;
+}
+
+/**
+ * @brief Queues a resize, replacing one already queued rather than reporting a size twice.
+ *
+ * The server keeps only its newest configure, so an older size queued behind it describes a
+ * surface that will never be adopted.
+ *
+ * @param state The surface state holding the queue.
+ * @param width The width the server configured.
+ * @param height The height the server configured.
+ */
+static void aplus_queue_resize(aplus_state_t *state, int width, int height)
+{
+    nsfb_event_t event;
+    unsigned i;
+
+    event.type = NSFB_EVENT_RESIZE;
+    event.value.resize.w = width;
+    event.value.resize.h = height;
+
+    for (i = state->head; i != state->tail; i = (i + 1) % APLUS_EVENT_QUEUE) {
+        if (state->queue[i].type == NSFB_EVENT_RESIZE) {
+            state->queue[i] = event;
+            return;
+        }
+    }
+
+    aplus_queue_push(state, &event);
+}
+
+/**
+ * @brief Queues a key or mouse button going down or coming up.
+ *
+ * @param state The surface state holding the queue.
+ * @param keycode The key the event is about.
+ * @param down Whether the key went down rather than came up.
+ */
+static void aplus_queue_key(aplus_state_t *state, enum nsfb_key_code_e keycode, bool down)
+{
+    nsfb_event_t event;
+
+    event.type = down ? NSFB_EVENT_KEY_DOWN : NSFB_EVENT_KEY_UP;
+    event.value.keycode = keycode;
+
+    aplus_queue_push(state, &event);
+}
+
+/**
+ * @brief Queues the button transitions between the buttons held before and the ones held now.
+ *
+ * @param state The surface state holding the queue.
+ * @param buttons The buttons the server reports as held.
+ */
+static void aplus_queue_buttons(aplus_state_t *state, uint8_t buttons)
+{
+    size_t i;
+
+    for (i = 0; i < sizeof(aplus_button_map) / sizeof(aplus_button_map[0]); i++) {
+        uint8_t mask = aplus_button_map[i].mask;
+
+        if (((state->buttons ^ buttons) & mask) == 0) {
+            continue;
+        }
+
+        aplus_queue_key(state, aplus_button_map[i].keycode, (buttons & mask) != 0);
+    }
+
+    state->buttons = buttons;
+}
+
+/**
+ * @brief Turns one server event into the libnsfb events it stands for.
+ *
+ * @param state The surface state holding the queue.
+ * @param ev The event the server sent.
+ */
+static void aplus_translate(aplus_state_t *state, const ui_event_t *ev)
+{
+    nsfb_event_t event;
+
+    switch (ev->type) {
+    case UI_EVENT_KEY:
+        if (ev->key.vkey < NR_KEYS && aplus_nsfb_map[ev->key.vkey] != NSFB_KEY_UNKNOWN) {
+            aplus_queue_key(state, aplus_nsfb_map[ev->key.vkey], ev->key.down != 0);
+        }
+        break;
+
+    case UI_EVENT_POINTER:
+        if ((ev->pointer.x != state->ptr_x) || (ev->pointer.y != state->ptr_y)) {
+            state->ptr_x = ev->pointer.x;
+            state->ptr_y = ev->pointer.y;
+
+            event.type = NSFB_EVENT_MOVE_ABSOLUTE;
+            event.value.vector.x = state->ptr_x;
+            event.value.vector.y = state->ptr_y;
+            event.value.vector.z = 0;
+
+            aplus_queue_push(state, &event);
+        }
+
+        aplus_queue_buttons(state, ev->pointer.buttons);
+        break;
+
+    case UI_EVENT_SCROLL: {
+        enum nsfb_key_code_e keycode;
+        int detents = ev->scroll.dy;
+        int i;
+
+        if (detents == 0) {
+            break;
+        }
+
+        keycode = (detents > 0) ? NSFB_KEY_MOUSE_4 : NSFB_KEY_MOUSE_5;
+        detents = (detents > 0) ? detents : -detents;
+
+        if (detents > APLUS_SCROLL_MAX) {
+            detents = APLUS_SCROLL_MAX;
+        }
+
+        for (i = 0; i < detents; i++) {
+            aplus_queue_key(state, keycode, true);
+            aplus_queue_key(state, keycode, false);
+        }
+        break;
+    }
+
+    case UI_EVENT_LEAVE:
+        aplus_queue_buttons(state, 0);
+        break;
+
+    case UI_EVENT_CONFIGURE:
+        aplus_queue_resize(state, ev->configure.width, ev->configure.height);
+        break;
+
+    case UI_EVENT_CLOSE:
+        event.type = NSFB_EVENT_CONTROL;
+        event.value.controlcode = NSFB_CONTROL_QUIT;
+
+        aplus_queue_push(state, &event);
+        break;
+
+    default:
+        break;
+    }
+}
+
+/**
+ * @brief Reports the window's surface as the framebuffer to plot into.
+ *
+ * @param nsfb The framebuffer context.
+ */
+static void aplus_attach(nsfb_t *nsfb)
+{
+    aplus_state_t *state = nsfb->surface_priv;
+
+    nsfb->width = ui_window_width(state->win);
+    nsfb->height = ui_window_height(state->win);
+    nsfb->ptr = (uint8_t *)ui_window_pixels(state->win);
+    nsfb->linelen = (int)ui_window_stride(state->win);
+}
+
+static bool aplus_copy(nsfb_t *nsfb, nsfb_bbox_t *srcbox, nsfb_bbox_t *dstbox);
+
+/**
+ * @brief Picks the software plotters for the format and wraps the copy one so it reports damage.
+ *
+ * @param nsfb The framebuffer context.
+ * @return 0 on success, or -1 when no plotters suit the format.
+ */
+static int aplus_select_plotters(nsfb_t *nsfb)
+{
+    aplus_state_t *state = nsfb->surface_priv;
+
+    if (select_plotters(nsfb) == false) {
+        return -1;
+    }
+
+    if (state != NULL) {
+        state->copy = nsfb->plotter_fns->copy;
+        nsfb->plotter_fns->copy = aplus_copy;
+    }
+
+    return 0;
+}
+
+/**
+ * @brief Moves a region of the surface, marking where it landed as changed.
+ *
+ * The pixels are the server's to read at any time, so a copy nothing else reports would
+ * otherwise reach the screen only when the next plot happened to overlap it.
+ *
+ * @param nsfb The framebuffer context.
+ * @param srcbox The region to copy from.
+ * @param dstbox The region to copy to.
+ * @return true on success.
+ */
+static bool aplus_copy(nsfb_t *nsfb, nsfb_bbox_t *srcbox, nsfb_bbox_t *dstbox)
+{
+    aplus_state_t *state = nsfb->surface_priv;
+
+    if (state->copy(nsfb, srcbox, dstbox) == false) {
+        return false;
+    }
+
+    ui_window_damage(state->win, dstbox->x0, dstbox->y0, dstbox->x1 - dstbox->x0, dstbox->y1 - dstbox->y0);
+
+    return true;
+}
+
+/**
+ * @brief Takes up the size the server last configured, the window's surface not being ours to size.
+ *
+ * @param nsfb The framebuffer context.
+ * @param width The width asked for, which only decides how large a window is created.
+ * @param height The height asked for.
+ * @param format The format asked for, which the server only ever answers with XRGB8888.
+ * @return 0 on success, or -1 on error.
+ */
+static int aplus_set_geometry(nsfb_t *nsfb, int width, int height, enum nsfb_format_e format)
+{
+    aplus_state_t *state = nsfb->surface_priv;
+
+    UNUSED(format);
+
+    nsfb->format = NSFB_FMT_XRGB8888;
+
+    if (state == NULL) {
+        nsfb->width = width;
+        nsfb->height = height;
+
+        return aplus_select_plotters(nsfb);
+    }
+
+    if (ui_window_apply_configure(state->win) < 0) {
+        return -1;
+    }
+
+    aplus_attach(nsfb);
+
+    return aplus_select_plotters(nsfb);
+}
+
+/**
+ * @brief Names the window, which the server draws in the decoration.
+ *
+ * @param nsfb The framebuffer context.
+ * @param parameters The title to give the window.
+ * @return 0 on success, or -1 on error.
+ */
+static int aplus_set_parameters(nsfb_t *nsfb, const char *parameters)
+{
+    aplus_state_t *state = nsfb->surface_priv;
+
+    if (state == NULL) {
+        return 0;
+    }
+
+    return ui_window_set_title(state->win, parameters) < 0 ? -1 : 0;
+}
+
+/**
+ * @brief Opens a window on the display server and plots into the surface it hands back.
+ *
+ * @param nsfb The framebuffer context.
+ * @return 0 on success, or -1 on error.
+ */
+static int aplus_initialise(nsfb_t *nsfb)
+{
+    aplus_state_t *state;
+    const char *title = nsfb->parameters;
+
+    if (nsfb->surface_priv != NULL) {
+        return -1;
+    }
+
+    state = calloc(1, sizeof(aplus_state_t));
+
+    if (state == NULL) {
+        return -1;
+    }
+
+    state->ptr_x = -1;
+    state->ptr_y = -1;
+
+    state->conn = ui_connect(NULL, APLUS_CONNECT_RETRY_MS);
+
+    if (state->conn == NULL) {
+        fprintf(stderr, "libnsfb: unable to reach the display server\n");
+        free(state);
+        return -1;
+    }
+
+    if ((title == NULL) || (*title == 0)) {
+        title = APLUS_DEFAULT_TITLE;
+    }
+
+    state->win = ui_window_create(state->conn, nsfb->width, nsfb->height, title);
+
+    if (state->win == NULL) {
+        fprintf(stderr, "libnsfb: unable to create a window\n");
+        ui_disconnect(state->conn);
+        free(state);
+        return -1;
+    }
+
+    nsfb->surface_priv = state;
+    nsfb->format = NSFB_FMT_XRGB8888;
+
+    aplus_attach(nsfb);
+
+    return aplus_select_plotters(nsfb);
+}
+
+/**
+ * @brief Closes the window and drops the connection.
+ *
+ * @param nsfb The framebuffer context.
+ * @return 0 on success.
+ */
+static int aplus_finalise(nsfb_t *nsfb)
+{
+    aplus_state_t *state = nsfb->surface_priv;
+
+    if (state == NULL) {
+        return 0;
+    }
+
+    ui_window_destroy(state->win);
+    ui_disconnect(state->conn);
+
+    free(state);
+
+    nsfb->surface_priv = NULL;
+    nsfb->ptr = NULL;
+
+    return 0;
+}
+
+/**
+ * @brief Waits for the next event, translating what the server sends into libnsfb events.
+ *
+ * @param nsfb The framebuffer context.
+ * @param event Receives the event.
+ * @param timeout How long to wait in milliseconds, polling at 0 and waiting indefinitely below it.
+ * @return true when an event was stored, false when a poll found nothing.
+ */
+static bool aplus_input(nsfb_t *nsfb, nsfb_event_t *event, int timeout)
+{
+    aplus_state_t *state = nsfb->surface_priv;
+
+    if (aplus_queue_pop(state, event) == true) {
+        return true;
+    }
+
+    for (;;) {
+        ui_event_t ev;
+
+        int got = ui_next_event(state->conn, &ev, timeout);
+
+        if (got < 0) {
+            event->type = NSFB_EVENT_CONTROL;
+            event->value.controlcode = NSFB_CONTROL_QUIT;
+            return true;
+        }
+
+        if (got == 0) {
+            if (timeout == 0) {
+                return false;
+            }
+
+            event->type = NSFB_EVENT_CONTROL;
+            event->value.controlcode = NSFB_CONTROL_TIMEOUT;
+            return true;
+        }
+
+        aplus_translate(state, &ev);
+
+        if (aplus_queue_pop(state, event) == true) {
+            return true;
+        }
+    }
+}
+
+/**
+ * @brief Tells the server which part of the surface changed and asks for it to be shown.
+ *
+ * @param nsfb The framebuffer context.
+ * @param box The region that was redrawn.
+ * @return 0 on success, or -1 on error.
+ */
+static int aplus_update(nsfb_t *nsfb, nsfb_bbox_t *box)
+{
+    aplus_state_t *state = nsfb->surface_priv;
+
+    ui_window_damage(state->win, box->x0, box->y0, box->x1 - box->x0, box->y1 - box->y0);
+
+    return ui_window_commit(state->win) < 0 ? -1 : 0;
+}
+
+/**
+ * @brief Accepts a cursor move without plotting anything, the server drawing the pointer itself.
+ *
+ * @param nsfb The framebuffer context.
+ * @param cursor The cursor libnsfb tracks.
+ * @return true.
+ */
+static int aplus_cursor(nsfb_t *nsfb, struct nsfb_cursor_s *cursor)
+{
+    UNUSED(nsfb);
+    UNUSED(cursor);
+
+    return true;
+}
+
+const nsfb_surface_rtns_t aplus_rtns = {
+    .initialise = aplus_initialise,
+    .finalise = aplus_finalise,
+    .input = aplus_input,
+    .update = aplus_update,
+    .cursor = aplus_cursor,
+    .geometry = aplus_set_geometry,
+    .parameters = aplus_set_parameters,
+};
+
+NSFB_SURFACE_DEF(aplus, NSFB_SURFACE_APLUS, &aplus_rtns)
+
