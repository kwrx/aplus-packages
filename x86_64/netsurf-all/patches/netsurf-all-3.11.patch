+
+/** title the window carries until ::nsfb_set_parameters names another */
+#define APLUS_DEFAULT_TITLE "NetSurf"
+
+/** one server event may become a move, three button transitions and a wheel pair */
+#define APLUS_EVENT_QUEUE 16
+
+/** wheel detents translated per scroll event, the rest being dropped rather than queued */
+#define APLUS_SCROLL_MAX 4
+
+typedef struct aplus_state_s {
+    ui_connection_t *conn; /**< connection to the display server */
+    ui_window_t *win; /**< the window whose surface is plotted into */
+
+    nsfb_plotfn_copy_t *copy; /**< software copy plotter, wrapped to report damage */
+
+    uint8_t buttons; /**< buttons held as of the last pointer event */
+    int ptr_x; /**< pointer position as of the last pointer event */
+    int ptr_y;
+
+    nsfb_event_t queue[APLUS_EVENT_QUEUE];
+    unsigned head;
+    unsigned tail;
+} aplus_state_t;
+
