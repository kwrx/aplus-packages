#!/bin/sh

root=${1:-/}

for d in \
    boot/grub \
    dev \
    etc/fonts \
    etc/init.d \
    etc/profile.d \
    home/root \
    media \
    mnt \
    opt \
    proc \
    run \
    srv/http \
    sys \
    tmp \
    usr/bin \
    usr/include \
    usr/lib/modules \
    usr/sbin \
    usr/share/applications \
    usr/local/bin \
    usr/local/include \
    usr/local/lib \
    usr/local/sbin \
    usr/local/share \
    var/cache \
    var/empty \
    var/lib/pkg \
    var/log \
    var/spool \
    var/tmp
do
    mkdir -p "$root/$d"
done

for d in bin sbin lib; do
    [ -e "$root/$d" ] || [ -L "$root/$d" ] || ln -s "usr/$d" "$root/$d"
done

if [ -d "$root/var/run" ] && [ ! -L "$root/var/run" ]; then
    rmdir "$root/var/run" 2>/dev/null
fi

[ -e "$root/var/run" ] || [ -L "$root/var/run" ] || ln -s ../run "$root/var/run"

exit 0
