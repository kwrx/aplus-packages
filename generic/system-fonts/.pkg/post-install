#!/bin/bash

prefix=$1

if ! command -v fc-scan > /dev/null; then
    echo "fc-scan not found, $prefix/etc/fonts/fonts.conf left as it is"
    exit 0
fi

mkdir -p "$prefix/etc/fonts"

find "$prefix/usr/share/fonts" -type f \( -iname '*.ttf' -o -iname '*.otf' \) -print0 | sort -z | while IFS= read -r -d '' font; do
    fc-scan --format "${font#$prefix}:%{family[0]}:%{style[0]}:%{spacing:-0}\n" "$font"
done > "$prefix/etc/fonts/fonts.conf.new"

mv "$prefix/etc/fonts/fonts.conf.new" "$prefix/etc/fonts/fonts.conf"

echo "Found $(wc -l < "$prefix/etc/fonts/fonts.conf") fonts"
